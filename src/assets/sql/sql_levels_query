-- 🧩 INFORMATION SCHEMA (456–475)

-- 456. List all tables in database
SELECT table_name FROM information_schema.tables WHERE table_schema = 'mydb';

-- 457. Get table row count
SELECT table_name, table_rows FROM information_schema.tables WHERE table_schema = 'mydb';

-- 458. Get column information
SELECT column_name, data_type FROM information_schema.columns WHERE table_name = 'users';

-- 459. Find tables with specific column
SELECT table_name FROM information_schema.columns WHERE column_name = 'email' AND table_schema = 'mydb';

-- 460. Get primary keys
SELECT column_name FROM information_schema.key_column_usage WHERE table_name = 'users' AND constraint_name = 'PRIMARY';

-- 461. Get foreign keys
SELECT constraint_name, column_name, referenced_table_name FROM information_schema.key_column_usage WHERE table_name = 'orders' AND referenced_table_name IS NOT NULL;

-- 462. Get table constraints
SELECT constraint_name, constraint_type FROM information_schema.table_constraints WHERE table_name = 'users';

-- 463. Find tables without primary key
SELECT table_name FROM information_schema.tables t WHERE table_schema = 'mydb' AND NOT EXISTS (SELECT 1 FROM information_schema.key_column_usage k WHERE k.table_name = t.table_name AND k.constraint_name = 'PRIMARY');

-- 464. Get index information
SELECT index_name, column_name FROM information_schema.statistics WHERE table_name = 'users';

-- 465. Table size information
SELECT table_name, ROUND((data_length + index_length) / 1024 / 1024, 2) as size_mb FROM information_schema.tables WHERE table_schema = 'mydb';

-- 466. Get view definition
SELECT view_definition FROM information_schema.views WHERE table_name = 'active_users';

-- 467. Find unused indexes
SELECT * FROM information_schema.statistics WHERE table_schema = 'mydb' AND index_name NOT IN (SELECT DISTINCT index_name FROM information_schema.statistics WHERE table_schema = 'mydb');

-- 468. Get trigger information
SELECT trigger_name, event_manipulation, event_object_table FROM information_schema.triggers WHERE trigger_schema = 'mydb';

-- 469. Get stored procedure info
SELECT routine_name, routine_type FROM information_schema.routines WHERE routine_schema = 'mydb';

-- 470. Check auto_increment values
SELECT table_name, auto_increment FROM information_schema.tables WHERE table_schema = 'mydb' AND auto_increment IS NOT NULL;

-- 471. Find duplicate column names
SELECT column_name, COUNT(*) FROM information_schema.columns WHERE table_schema = 'mydb' GROUP BY column_name HAVING COUNT(*) > 1;

-- 472. Get collation information
SELECT table_name, table_collation FROM information_schema.tables WHERE table_schema = 'mydb';

-- 473. Find nullable columns
SELECT table_name, column_name FROM information_schema.columns WHERE table_schema = 'mydb' AND is_nullable = 'YES';

-- 474. Get column defaults
SELECT column_name, column_default FROM information_schema.columns WHERE table_name = 'users';

-- 475. Find tables modified recently
SELECT table_name, update_time FROM information_schema.tables WHERE table_schema = 'mydb' ORDER BY update_time DESC;

-- 🧩 SET OPERATIONS (476–490)

-- 476. Union of two queries
SELECT firstname FROM users WHERE city = 'Chennai' UNION SELECT firstname FROM users WHERE city = 'Mumbai';

-- 477. Union all (with duplicates)
SELECT city FROM users UNION ALL SELECT city FROM addresses;

-- 478. Intersect simulation
SELECT DISTINCT city FROM users WHERE city IN (SELECT city FROM addresses);

-- 479. Except simulation (MINUS)
SELECT city FROM users WHERE city NOT IN (SELECT city FROM addresses);

-- 480. Union with order by
SELECT firstname, age FROM users WHERE city = 'Chennai' UNION SELECT firstname, age FROM users WHERE city = 'Delhi' ORDER BY age;

-- 481. Union different column counts (matched)
SELECT firstname, lastname FROM users UNION SELECT product_name, NULL FROM products;

-- 482. Complex union with joins
SELECT u.firstname, o.amount FROM users u INNER JOIN orders o ON u.user_id = o.user_id UNION SELECT c.name, c.credit_amount FROM customers c;

-- 483. Union with aggregation
SELECT city, COUNT(*) as cnt FROM users GROUP BY city UNION SELECT 'Total', COUNT(*) FROM users;

-- 484. Multiple unions
SELECT 'Users' as type, COUNT(*) FROM users UNION SELECT 'Orders', COUNT(*) FROM orders UNION SELECT 'Products', COUNT(*) FROM products;

-- 485. Union with calculated columns
SELECT firstname, age, age * 2 as double_age FROM users WHERE city = 'Chennai' UNION SELECT firstname, age, age * 3 FROM users WHERE city = 'Mumbai';

-- 486. Union with CASE
SELECT firstname, CASE WHEN age > 30 THEN 'Senior' ELSE 'Junior' END as category FROM users WHERE city = 'Chennai' UNION SELECT firstname, 'All' FROM users WHERE city = 'Delhi';

-- 487. Intersect with aggregation
SELECT city FROM users GROUP BY city HAVING COUNT(*) > 5 INTERSECT SELECT city FROM orders o INNER JOIN users u ON o.user_id = u.user_id GROUP BY u.city HAVING SUM(amount) > 10000;

-- 488. Nested union
SELECT * FROM (SELECT firstname FROM users WHERE age > 30 UNION SELECT firstname FROM users WHERE city = 'Chennai') AS combined;

-- 489. Union with limit
(SELECT * FROM users ORDER BY age LIMIT 5) UNION (SELECT * FROM users ORDER BY age DESC LIMIT 5);

-- 490. Symmetric difference
SELECT city FROM users WHERE city NOT IN (SELECT city FROM addresses) UNION SELECT city FROM addresses WHERE city NOT IN (SELECT city FROM users);

